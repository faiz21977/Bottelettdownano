# ============================================
# ENVIRONMENT VARIABLES - TikTok Telegram Bot
# ============================================

# Token bot dari BotFather Telegram
# Cara dapat: chat @BotFather → /newbot → ikuti instruksi
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# URL deployment Vercel kamu (diisi setelah deploy)
# Contoh: https://tiktok-bot-username.vercel.app
VERCEL_URL=https://your-project.vercel.app

# Secret token untuk keamanan webhook (isi bebas, minimal 8 karakter)
WEBHOOK_SECRET=your_random_secret_string_here
